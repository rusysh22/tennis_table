# Required application security
SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash

# Set to 0 only for local HTTP development. Keep 1 behind HTTPS.
SESSION_COOKIE_SECURE=1
ADMIN_SESSION_HOURS=8
# Sized for batch galeri uploads (up to 10 photos in one request).
MAX_UPLOAD_BYTES=50331648
MAX_IMAGE_PIXELS=25000000

# Storage cutover is explicit. Keep `legacy` for local JSON or the
# self-hosted Postgres tennis.app_data table; use `normalized` only after
# the migration/import verification checklist.
STORAGE_BACKEND=legacy
# Point at Postgres running in Docker on the VPS itself (no external/managed
# DB service). Leave empty to use local data/*.json files instead.
DATABASE_URL=
TOURNAMENT_SLUG=intersport-2026
TOURNAMENT_TIMEZONE=Asia/Jakarta

# Match/champion/gallery photos are always compressed (JPEG, max 1200px) and
# saved to static/uploads on local disk -- no external object storage.
